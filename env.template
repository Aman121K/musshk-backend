# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27018/musk

# Server Configuration
PORT=5000

# CORS: comma-separated origins allowed to call the API (admin + main site)
# If not set, defaults: admin.musshk.com, musshk.com, www.musshk.com, localhost
# Use the exact origin the browser sends (e.g. https://www.musshk.com if site is on www)
# CORS_ORIGINS=https://admin.musshk.com,https://musshk.com,https://www.musshk.com

# JWT Secret (Change this in production!)
JWT_SECRET=your-secret-key-change-in-production

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_SBJlI3LInAUFFp
RAZORPAY_KEY_SECRET=1pxn1a7tc9vKiOwQQ0D4Pt33

# Razorpay Webhook Secret (Get this from Razorpay Dashboard after creating webhook)
# Go to: Razorpay Dashboard → Settings → Webhooks → Copy Webhook Secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_from_razorpay_dashboard

# AWS S3 Configuration (for image uploads - admin uploads direct to S3, URL stored in DB)
# Required for direct-to-S3 upload from admin; if missing, admin falls back to upload via API
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_S3_BASE_URL=https://your-bucket-name.s3.us-east-1.amazonaws.com
# S3 bucket: enable public read for objects (or use CloudFront). Set CORS to allow PUT from your admin origin.

# Website URL (for subscriber emails - links to new products/blogs)
# SITE_URL=https://musshk.com

